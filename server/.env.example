# ---------------------------------------------------------------------------
# Nexora API — environment variables
# Copy to server/.env and replace every placeholder. Never commit real secrets.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the Nexora API listens on
PORT=4000

# Comma-separated list of allowed browser origins (the frontend).
# No wildcard. Example for a Vite dev server:
CORS_ORIGIN=http://localhost:5173

# Base URL of the frontend (used for links in emails, if any).
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string.
# Local example (PostgreSQL 16, port 5433, database hackathon_db).
# Replace USER and PASSWORD with your own local credentials.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/hackathon_db?schema=public

# Secret used to authenticate backend-held secrets and derived values.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# How long a login session lasts, in hours (default 720 = 30 days).
SESSION_TTL_HOURS=720

# Name of the session cookie (default nexora_session).
COOKIE_NAME=nexora_session

# The cookie domain, if the API is served from a subdomain.
# COOKIE_DOMAIN=

# Set COOKIE_SECURE=true to send the cookie only over HTTPS.
# Defaults to true in production, false otherwise.
# COOKIE_SECURE=true

# Log level for the API logger.
LOG_LEVEL=info