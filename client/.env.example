# Base URL of the Nexora API (see server/). Adjust if you change the API port.
VITE_API_BASE_URL=http://localhost:4000
# Socket.IO endpoint. Leave empty to reuse VITE_API_BASE_URL.
VITE_SOCKET_URL=
# Set to "true" to enable the demo-data mode (never used in production builds).
# VITE_DEMO_MODE=false